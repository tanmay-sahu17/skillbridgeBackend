{
  "name": "skillbridge-backend",
  "version": "1.2.0",
  "type": "module",
  "description": "Production-ready Node.js, Express.js, and MongoDB backend boilerplate",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "echo \"Error: no lint script specified\" && exit 0",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "prisma:generate": "npx prisma generate",
    "prisma:validate": "npx prisma validate",
    "prisma:push": "npx prisma db push",
    "prisma:pull": "npx prisma db pull",
    "prisma:studio": "npx prisma studio",
    "prisma:reset": "npx prisma db push --force-reset",
    "postinstall": "npx prisma generate",
    "prepare": "husky"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "boilerplate",
    "mvc",
    "production-ready"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@elastic/elasticsearch": "^8.12.1",
    "@imagekit/nodejs": "^7.10.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.2",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^6.0.1",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "resend": "^6.18.1",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.0.2",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2"
  }
}
