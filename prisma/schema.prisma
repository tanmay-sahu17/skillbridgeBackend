// SkillBridge — Prisma Schema for MongoDB
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  COLLEGE
  STUDENT
  RECRUITER
  TPO
  ADMIN
}

enum CollegeType {
  GOVERNMENT
  PRIVATE
  AUTONOMOUS
  DEEMED
}

enum CampusType {
  SINGLE
  MULTIPLE
}

enum Designation {
  PRINCIPAL
  DIRECTOR
  TPO
  DEAN
  HOD
  FACULTY
  ADMIN_STAFF
}

enum CollegeStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum StudentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CareerInterest {
  INTERNSHIP
  FULL_TIME
  FREELANCING
  STARTUP
  RESEARCH
  HIGHER_STUDIES
}

enum PlatformRole {
  FREELANCER
  OPPORTUNITY_PROVIDER
  BOTH
}

// ==================== COMPOSITE TYPES (Embedded Documents) ====================

type OtherLink {
  type String
  url  String
}

type SocialLinks {
  linkedin   String?
  facebook   String?
  instagram  String?
  otherLinks OtherLink[]
}

type CollegeBasicInfo {
  collegeName          String
  domain               String?
  shortName            String?
  collegeType          CollegeType
  establishmentYear    Int
  affiliatedUniversity String
  accreditations       String[]
}

type CollegeContactInfo {
  officialEmail    String
  officialMobile   String
  alternateContact String?
  officialWebsite  String
  socialLinks      SocialLinks?
}

type CollegeAddress {
  country         String
  state           String
  district        String
  city            String
  pinCode         String
  completeAddress String
}

type CollegeRepresentative {
  fullName      String
  designation   Designation
  officialEmail String
  mobileNumber  String
  employeeId    String?
}

type CollegeDocumentInfo {
  collegeLogo         String
  affiliationCert     String
  authorizationLetter String
  naacCertificate     String?
  nirfCertificate     String?
  collegeBrochure     String?
  gstCertificate      String?
  otherCertificates   String[]
}

type CollegeAcademicInfo {
  totalDepartments Int
  departments      String[]
  totalCourses     Int
  courses          String[]
  totalStudents    Int
  totalFaculty     Int
  campusType       CampusType
}

type CollegeVerification {
  emailVerified  Boolean
  mobileVerified Boolean
}

type StudentBasicInfo {
  firstName    String
  middleName   String?
  lastName     String
  profilePhoto String?
  gender       Gender?
  dateOfBirth  DateTime?
}

type StudentContactInfo {
  personalEmail   String
  mobileNumber    String
  alternateMobile String?
}

type StudentAcademicInfo {
  enrollmentNo    String
  studentIdNo     String?
  course          String
  branch          String
  currentYear     Int
  currentSemester Int
  section         String?
  batch           String
}

type StudentCareerProfile {
  headline       String?
  skills         String[]
  careerInterest CareerInterest[]
  languagesKnown String[]
  bio            String?
}

type StudentPortfolio {
  resumeUrl          String?
  linkedin           String?
  github             String?
  portfolioWebsite   String?
  leetcode           String?
  hackerrank         String?
  codechef           String?
  codeforces         String?
  behanceOrDribbble  String?
  otherLinks         OtherLink[]
}

type StudentDocuments {
  studentIdCardFront String
  studentIdCardBack  String?
  bonafideCert       String?
  feeReceipt         String?
}

type StudentVerification {
  emailVerified  Boolean
  mobileVerified Boolean
}

// ==================== MODELS ====================

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email            String   @unique
  password         String
  role             Role
  isActive         Boolean  @default(true)
  isEmailVerified  Boolean  @default(false)
  college          College?
  student          Student?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model College {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
  students Student[]

  // Section-wise embedded data
  basicInfo           CollegeBasicInfo?
  contactInfo         CollegeContactInfo?
  address             CollegeAddress?
  representative      CollegeRepresentative?
  documents           CollegeDocumentInfo?
  academicInfo        CollegeAcademicInfo?
  verification        CollegeVerification?

  // Onboarding tracking
  currentStep         Int     @default(1)
  completedSections   Int[]   @default([])
  onboardingCompleted Boolean @default(false)

  // Section 9: Terms & Declaration
  termsAccepted       Boolean @default(false)
  authorizedConfirmed Boolean @default(false)
  accuracyConfirmed   Boolean @default(false)

  // Admin review
  status CollegeStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Student {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
  
  collegeId String @db.ObjectId
  college   College @relation(fields: [collegeId], references: [id])

  // Onboarding Sections
  basicInfo           StudentBasicInfo?
  contactInfo         StudentContactInfo?
  academicInfo        StudentAcademicInfo?
  careerProfile       StudentCareerProfile?
  portfolio           StudentPortfolio?
  documents           StudentDocuments?
  platformRole        PlatformRole?
  verification        StudentVerification?

  // Section 9: Declaration
  infoCorrectConfirmed  Boolean @default(false)
  collegeVerifyAccepted Boolean @default(false)
  termsAccepted         Boolean @default(false)

  // Onboarding tracking
  currentStep         Int     @default(1)
  completedSections   Int[]   @default([])
  onboardingCompleted Boolean @default(false)

  // Admin / College review
  status StudentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collegeId])
}
