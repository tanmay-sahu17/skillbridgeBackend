// SkillBridge — Prisma Schema for MongoDB
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  COLLEGE
  STUDENT
  RECRUITER
  TPO
  ADMIN
  COLLEGE_STAFF
}

enum CrudAction {
  CREATE
  READ
  UPDATE
  DELETE
}

enum CollegeType {
  GOVERNMENT
  PRIVATE
  AUTONOMOUS
  DEEMED
}

enum CampusType {
  SINGLE
  MULTIPLE
}

enum Designation {
  PRINCIPAL
  DIRECTOR
  TPO
  DEAN
  HOD
  FACULTY
  ADMIN_STAFF
}

enum CollegeStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum StudentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CareerInterest {
  INTERNSHIP
  FULL_TIME
  FREELANCING
  STARTUP
  RESEARCH
  HIGHER_STUDIES
}

enum PlatformRole {
  FREELANCER
  OPPORTUNITY_PROVIDER
  BOTH
}

// ==================== COMPOSITE TYPES (Embedded Documents) ====================

type OtherLink {
  type String
  url  String
}

type SocialLinks {
  linkedin   String?
  facebook   String?
  instagram  String?
  otherLinks OtherLink[]
}

type CollegeBasicInfo {
  collegeName          String
  domain               String?
  shortName            String?
  collegeType          CollegeType
  establishmentYear    Int
  affiliatedUniversity String
  accreditations       String[]
}

type CollegeContactInfo {
  officialEmail    String
  officialMobile   String
  alternateContact String?
  officialWebsite  String
  socialLinks      SocialLinks?
}

type CollegeAddress {
  country         String
  state           String
  district        String
  city            String
  pinCode         String
  completeAddress String
}

type CollegeRepresentative {
  fullName      String
  designation   Designation
  officialEmail String
  mobileNumber  String
  employeeId    String?
}

type CollegeDocumentInfo {
  collegeLogo         String
  affiliationCert     String
  authorizationLetter String
  naacCertificate     String?
  nirfCertificate     String?
  collegeBrochure     String?
  gstCertificate      String?
  otherCertificates   String[]
}

type CollegeAcademicInfo {
  totalDepartments Int
  departments      String[]
  totalCourses     Int
  courses          String[]
  totalStudents    Int
  totalFaculty     Int
  campusType       CampusType
}

type CollegeVerification {
  emailVerified  Boolean
  mobileVerified Boolean
}

type StudentBasicInfo {
  firstName    String
  middleName   String?
  lastName     String
  profilePhoto String?
  gender       Gender?
  dateOfBirth  DateTime?
}

type StudentContactInfo {
  personalEmail   String
  mobileNumber    String
  alternateMobile String?
}

type StudentAcademicInfo {
  enrollmentNo    String
  studentIdNo     String?
  course          String
  branch          String
  currentYear     Int
  currentSemester Int
  section         String?
  batch           String
}

type StudentCareerProfile {
  headline       String?
  skills         String[]
  careerInterest CareerInterest[]
  languagesKnown String[]
  bio            String?
}

type StudentPortfolio {
  resumeUrl          String?
  linkedin           String?
  github             String?
  portfolioWebsite   String?
  leetcode           String?
  hackerrank         String?
  codechef           String?
  codeforces         String?
  behanceOrDribbble  String?
  otherLinks         OtherLink[]
}

type StudentDocuments {
  studentIdCardFront String
  studentIdCardBack  String?
  bonafideCert       String?
  feeReceipt         String?
}

type StudentVerification {
  emailVerified  Boolean
  mobileVerified Boolean
}

// ==================== MODELS ====================

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email            String   @unique
  password         String
  role             Role
  isActive         Boolean  @default(true)
  isEmailVerified  Boolean  @default(false)
  college          College?
  student          Student?

  // RBAC Relations
  customRoleId     String?  @db.ObjectId
  customRole       CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  collegeStaffId   String?  @db.ObjectId
  employerCollege  College? @relation("CollegeStaff", fields: [collegeStaffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userMenuPermissions UserMenuPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model College {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
  students Student[]
  staffUsers User[] @relation("CollegeStaff")
  customRoles CustomRole[]

  // Section-wise embedded data
  basicInfo           CollegeBasicInfo?
  contactInfo         CollegeContactInfo?
  address             CollegeAddress?
  representative      CollegeRepresentative?
  documents           CollegeDocumentInfo?
  academicInfo        CollegeAcademicInfo?
  verification        CollegeVerification?

  // Onboarding tracking
  currentStep         Int     @default(1)
  completedSections   Int[]   @default([])
  onboardingCompleted Boolean @default(false)

  // Section 9: Terms & Declaration
  termsAccepted       Boolean @default(false)
  authorizedConfirmed Boolean @default(false)
  accuracyConfirmed   Boolean @default(false)

  // Admin review
  status CollegeStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String?
  mobile    String?
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([mobile])
}

model OtpTracker {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier    String   @unique // email or mobile
  attempts      Int      @default(0)
  cooldownUntil DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Student {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
  
  collegeId String @db.ObjectId
  college   College @relation(fields: [collegeId], references: [id])

  // Onboarding Sections
  basicInfo           StudentBasicInfo?
  contactInfo         StudentContactInfo?
  academicInfo        StudentAcademicInfo?
  careerProfile       StudentCareerProfile?
  portfolio           StudentPortfolio?
  documents           StudentDocuments?
  platformRole        PlatformRole?
  verification        StudentVerification?

  // Section 9: Declaration
  infoCorrectConfirmed  Boolean @default(false)
  collegeVerifyAccepted Boolean @default(false)
  termsAccepted         Boolean @default(false)

  // Onboarding tracking
  currentStep         Int     @default(1)
  completedSections   Int[]   @default([])
  onboardingCompleted Boolean @default(false)

  // Admin / College review
  status StudentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collegeId])
}

// ==================== RBAC MODELS ====================

model CustomRole {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   // e.g., "TPO", "backend_engineer"
  description String?
  collegeId   String?  @db.ObjectId // If null, it's a global/base role template
  college     College? @relation(fields: [collegeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  roleMenuPermissions RoleMenuPermission[]
  users               User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, collegeId])
}

model Menu {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  path      String   @unique
  icon      String?
  parentId  String?  @db.ObjectId // For nested menus
  order     Int      @default(0)

  roleMenuPermissions RoleMenuPermission[]
  userMenuPermissions UserMenuPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoleMenuPermission {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  customRoleId String     @db.ObjectId
  customRole   CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)
  
  menuId       String     @db.ObjectId
  menu         Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  
  actions      CrudAction[] // Defines allowed actions for this role on this menu

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([customRoleId, menuId])
}

model UserMenuPermission {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  userId       String     @db.ObjectId
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  menuId       String     @db.ObjectId
  menu         Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  
  actions      CrudAction[] // Overrides the CustomRole actions entirely for this user on this menu

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, menuId])
}
